		<!-- Estilo visual de La Pulpe :joz1303 -->
		<property name="styleSheet">
			<string notr="true">
				QMainWindow {
				background-color: #F2F6F3;
				}

				QWidget#centralwidget {
				background-color: #F2F6F3;
				}

				QFrame#encabezado {
