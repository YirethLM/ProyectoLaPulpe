				background-color: #FFFFFF;
				border: 1px solid #DFE9E2;
				border-radius: 14px;
				}

				QLabel#tituloBusqueda,
				QLabel#tituloTabla {
				color: #204F38;
				font-size: 16px;
				font-weight: bold;
				border: none;
				}

				QLabel#descripcionBusqueda {
				color: #75877B;
				font-size: 12px;
				border: none;
				}

				QLineEdit#campoBusqueda {
				background-color: #F8FBF9;
				color: #193A29;
				border: 1px solid #C7DCCF;
				border-radius: 9px;
				padding: 10px;
				font-size: 13px;
				}

				QLineEdit#campoBusqueda:focus {
				border: 2px solid #259B60;
				background-color: #FFFFFF;
				}

				QTableWidget#tablaHistorial {
				background-color: #FFFFFF;
				alternate-background-color: #F3F9F5;
				color: #263F30;
				border: 1px solid #E2EBE5;
				border-radius: 7px;
				gridline-color: #E8F0EA;
				selection-background-color: #CBEAD7;
				selection-color: #173C29;
				font-size: 13px;
				}

				QHeaderView::section {
				background-color: #E6F2E9;
				color: #20573B;
				font-weight: bold;
				padding: 11px;
				border: none;
				border-bottom: 1px solid #CEDFD3;
				}

				QTableWidget::item {
				padding: 8px;
				}

				QStatusBar {
				background-color: #F2F6F3;
				color: #667B6C;
				}
